install(DIRECTORY config/ DESTINATION ${MININIDS_DATA_DIR}/config)
install(FILES README.md RUNBOOK.md LICENSE packaging/THIRD_PARTY_NOTICES.md DESTINATION ${MININIDS_DATA_DIR})
install(FILES docs/zip-import.md docs/building.md docs/releases.md DESTINATION ${MININIDS_DATA_DIR}/docs)
install(DIRECTORY packaging/licenses/ DESTINATION ${MININIDS_DATA_DIR}/licenses)
if(UNIX AND NOT APPLE AND MININIDS_BUILD_GUI)
  install(PROGRAMS packaging/linux/Mini-NIDS DESTINATION .)
  install(FILES packaging/linux/org.mininids.MiniNIDS.desktop DESTINATION ${CMAKE_INSTALL_DATADIR}/applications)
  install(FILES assets/icons/org.mininids.MiniNIDS.svg DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps)
endif()
set(CPACK_PACKAGE_NAME MiniNIDS)
set(CPACK_PACKAGE_VENDOR "Mini-NIDS contributors")
set(CPACK_PACKAGE_CONTACT "Mini-NIDS maintainers")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Offline network capture and intrusion analysis")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}/packages")
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" package_arch)
if(package_arch MATCHES "amd64|x86_64")
  set(package_arch x64)
elseif(package_arch MATCHES "aarch64|arm64")
  set(package_arch arm64)
endif()
if(WIN32)
  set(package_platform windows)
  set(CPACK_GENERATOR ZIP)
elseif(APPLE)
  set(package_platform macos)
  set(CPACK_GENERATOR DragNDrop)
  set(CPACK_DMG_VOLUME_NAME "Mini-NIDS")
  set(CPACK_DMG_FORMAT UDZO)
else()
  set(package_platform linux)
  set(CPACK_GENERATOR "TGZ;DEB;RPM")
  set(CPACK_DEBIAN_PACKAGE_NAME mini-nids)
  set(CPACK_DEBIAN_PACKAGE_VERSION "${PROJECT_VERSION}")
  set(CPACK_RPM_PACKAGE_VERSION "${PROJECT_VERSION}")
  set(CPACK_RPM_PACKAGE_RELEASE 1)
  if(MININIDS_PACKAGE_LABEL MATCHES "-dev\\.")
    set(CPACK_DEBIAN_PACKAGE_VERSION "${PROJECT_VERSION}~dev.${MININIDS_PACKAGE_REVISION}")
    set(CPACK_RPM_PACKAGE_RELEASE "0.dev.${MININIDS_PACKAGE_REVISION}")
  elseif(MININIDS_PACKAGE_LABEL MATCHES "^[0-9.]+-(.+)$")
    set(CPACK_DEBIAN_PACKAGE_VERSION "${PROJECT_VERSION}~${CMAKE_MATCH_1}")
    string(REPLACE "-" "." rpm_suffix "${CMAKE_MATCH_1}")
    set(CPACK_RPM_PACKAGE_RELEASE "0.${rpm_suffix}")
  endif()
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Mini-NIDS maintainers")
  set(CPACK_DEBIAN_PACKAGE_SECTION net)
  set(CPACK_DEBIAN_PACKAGE_DEPENDS "libc6 (>= 2.35), libgl1, libegl1, libvulkan1")
  set(CPACK_RPM_PACKAGE_NAME mini-nids)
  set(CPACK_RPM_PACKAGE_LICENSE MIT)
  set(CPACK_RPM_PACKAGE_AUTOREQPROV OFF)
  set(CPACK_RPM_PACKAGE_REQUIRES "glibc >= 2.35, libGL.so.1()(64bit), libEGL.so.1()(64bit), libvulkan.so.1()(64bit)")
  set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION /opt /usr/bin /usr/share/applications
      /usr/share/icons /usr/share/icons/hicolor /usr/share/icons/hicolor/scalable
      /usr/share/icons/hicolor/scalable/apps)
endif()
set(CPACK_PACKAGE_FILE_NAME "Mini-NIDS-${MININIDS_PACKAGE_LABEL}-${package_platform}-${package_arch}")
include(CPack)
