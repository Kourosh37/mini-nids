include(FetchContent)
function(mininids_dependency name version url)
  find_package(${name} ${version} CONFIG QUIET)
  if(NOT ${name}_FOUND)
    if(NOT MININIDS_FETCH_DEPS)
      message(FATAL_ERROR "Missing ${name}; install vcpkg manifest dependencies or enable MININIDS_FETCH_DEPS")
    endif()
    FetchContent_Declare(${name} URL ${url} DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(${name})
  endif()
endfunction()
set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_TESTS OFF CACHE BOOL "" FORCE)
