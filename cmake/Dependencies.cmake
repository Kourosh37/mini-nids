include(FetchContent)
function(mininids_dependency name version url sha256)
  find_package(${name} ${version} CONFIG QUIET)
  if(NOT ${name}_FOUND)
    if(NOT MININIDS_FETCH_DEPS)
      message(FATAL_ERROR "Missing ${name}; install vcpkg manifest dependencies or enable MININIDS_FETCH_DEPS")
    endif()
    FetchContent_Declare(${name} URL ${url} URL_HASH SHA256=${sha256} DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(${name})
  endif()
endfunction()
